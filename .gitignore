logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===================================
# Runtime data
# ===================================
pids/
*.pid
*.seed
*.pid.lock

# ===================================
