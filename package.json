{
  "name": "urbancruisebackend",
  "version": "1.0.0",
  "description": "Backend API for Urban Cruise, providing secure, reliable and scalable services for the company's mobile applications.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "depcruise": "depcruise --config .depcruiserc.cjs src",
    "lint": "eslint .",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": ["eslint --fix", "prettier --write"],
    "*.{json,md,yml,yaml}": ["prettier --write"]
  },
  "keywords": [
    "urban-cruise",
    "backend",
    "api",
    "typescript",
    "express",
    "mysql"
  ],
  "author": "urban cruise",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.3.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "mysql2": "^3.24.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
