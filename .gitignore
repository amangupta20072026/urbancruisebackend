coverage/
*.lcov
.nyc_output/

# ===================================
# Cache
# ===================================
.npm/
.eslintcache
.cache/
.parcel-cache/
*.tsbuildinfo

# ===================================
# Editor / IDE
# ===================================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ===================================
